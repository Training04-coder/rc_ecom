#!/bin/bash
set -euxo pipefail

# 1) Java 21 (JDK complet : le source launcher `java App.java` a besoin du compilateur)
dnf install -y java-21-amazon-corretto-devel

# 2) Application (single-file Java, lancee sans build) telechargee depuis S3 - version ${app_hash}
# Retentatives : le role IAM peut mettre quelques secondes a etre effectif apres sa creation
mkdir -p /opt/app
for attempt in $(seq 30); do
  aws s3 cp "s3://${bucket}/" /opt/app/ --recursive --region ${region} && break
  sleep 10
done
test -f /opt/app/App.java

cat > /etc/systemd/system/javaapp.service <<UNIT
[Unit]
Description=Mini site Java
After=network-online.target

[Service]
Environment=PORT=8080
Environment=BIND=127.0.0.1
Environment=DEMO_VULN=${demo_vuln}
WorkingDirectory=/opt/app
ExecStart=/usr/bin/java /opt/app/App.java
Restart=always
DynamicUser=yes
LogsDirectory=bricoshop

[Install]
WantedBy=multi-user.target
UNIT

# 3) Caddy : reverse proxy + certificat HTTPS Let's Encrypt automatique
curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=amd64" -o /usr/local/bin/caddy
chmod +x /usr/local/bin/caddy
mkdir -p /etc/caddy /var/lib/caddy

cat > /etc/caddy/Caddyfile <<CADDY
${fqdn} {
  reverse_proxy 127.0.0.1:8080
}
CADDY

cat > /etc/systemd/system/caddy.service <<UNIT
[Unit]
Description=Caddy
After=network-online.target

[Service]
Environment=HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now javaapp caddy
